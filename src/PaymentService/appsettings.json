    "ClientId": "payment-service",
    "ClientSecret": ""
  },
  "Recuperacion": {
    "Enabled": true,
    "Intervalo": "00:00:10",
    "EsperaMinima": "00:00:15",
    "MaxIntentos": 5
  },
  "Database": {
    "MigrateOnStartup": false
  }
